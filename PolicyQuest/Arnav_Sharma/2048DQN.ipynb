   "source": [
    "model = NeuralNetwork1()\n",
    "device = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
    "print(device)\n",
    "model = model.to(device)\n",
    "model2 = NeuralNetwork2()\n",
    "model2 = model2.to(device)\n",
    "optimizer = optim.Adam(model.parameters(), lr=0.0001)"
   ]
  },
