   "source": [
    "def q_hat_prime_action(feature):\n",
    "    feature = torch.tensor(feature, dtype=torch.float32)\n",
    "    feature = feature.to(device)\n",
    "    return (torch.argmax(model2(feature))).detach()"
   ]
  },
